<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manage Bookings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <a href="/">Home</a>
        <a href="/cars">Available Cars</a>
        <a href="/list_bookings">My Bookings</a>
        <a href="/testimonials">Testimonials</a>
        <a href="/account">Account</a>
    </nav>

    <div class="container">
        <h1>Your Bookings</h1>
        <table>
            <tr>
                <th>Booking ID</th>
                <th>Car Name</th>
                <th>User Email</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
            <% bookings.forEach(b => { %>
                <tr>
                    <td><%= b.booking_id %></td>
                    <td><%= b.car_name %></td>
                    <td><%= b.user_email %></td>
                    <td><%= b.start_date %></td>
                    <td><%= b.end_date %></td>
                    <td><%= b.status %></td>
                    <td><a class="action-btn" href="/delete_booking/<%= b.booking_id %>">Cancel</a></td>
                </tr>
            <% }) %>
        </table>
    </div>
</body>
</html>