<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Testimonials</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <a href="/">Home</a>
        <a href="/cars">Available Cars</a>
        <a href="/list_bookings">My Bookings</a>
        <a href="/testimonials">Testimonials</a>
        <a href="/account">Account</a>
    </nav>

    <div class="container">
        <h1>Customer Testimonials</h1>
        <ul>
            <% testimonials.forEach(t => { %>
                <li><strong><%= t.name %></strong> (Rating: <%= t.rating %>/5): "<%= t.comment %>"</li>
            <% }) %>
        </ul>

        <h2>Leave a Testimonial</h2>
        <form action="/add_testimonial" method="POST">
            <input type="text" name="name" placeholder="Your Name" required>
            <textarea name="comment" placeholder="Your Feedback" rows="3" required></textarea>
            <input type="number" name="rating" min="1" max="5" placeholder="Rating (1-5)" required>
            <button type="submit">Submit Feedback</button>
        </form>
    </div>
</body>
</html>